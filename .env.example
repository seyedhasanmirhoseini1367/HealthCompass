# ── Copy this file to .env and fill in your values ────────────────────────────
# .env is git-ignored and must NEVER be committed.
# On Railway, set these as environment variables in the service settings.

# ── Django core ────────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

DEBUG=False

# Comma-separated. Include your Railway domain and custom subdomain.
# Example: healthcompass.hasanai.net,healthcompass-production.up.railway.app
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated origins for CSRF. Must match ALLOWED_HOSTS with https:// prefix.
# Example: https://healthcompass.hasanai.net,https://healthcompass-production.up.railway.app
CSRF_TRUSTED_ORIGINS=

# ── Database ───────────────────────────────────────────────────────────────────
# Railway injects this automatically when a PostgreSQL plugin is added.
# Leave unset locally to use SQLite.
DATABASE_URL=

# ── Email (optional — only needed if sending real emails) ─────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@healthcompass.dev

# ── AI API keys ────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
