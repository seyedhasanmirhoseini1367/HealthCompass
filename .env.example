# ── Copy this file to .env and fill in your values ────────────────────────────
# .env is git-ignored and must NEVER be committed.
# On Railway, set these as environment variables in the service settings.

# ── Django core ────────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

DEBUG=False

# Comma-separated. Include your Railway domain and custom subdomain.
# Example: healthcompass.hasanai.net,healthcompass-production.up.railway.app
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated origins for CSRF. Must match ALLOWED_HOSTS with https:// prefix.
# Example: https://healthcompass.hasanai.net,https://healthcompass-production.up.railway.app
CSRF_TRUSTED_ORIGINS=

# ── Database ───────────────────────────────────────────────────────────────────
# Railway injects this automatically when a PostgreSQL plugin is added.
# Leave unset locally to use SQLite.
DATABASE_URL=

# ── Email (optional — only needed if sending real emails) ─────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@healthcompass.dev

# ── AI API keys ────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Firebase Cloud Messaging (push notifications) ─────────────────────────────
# Full service-account JSON as a single-line string. Firebase Console →
# Project Settings → Service Accounts → Generate new private key.
# Required for appointment reminder pushes; without it, send_push() no-ops.
FIREBASE_CREDENTIALS_JSON=

# ── Privacy: consent & external data egress ───────────────────────────────────
# Which consent purposes block their feature when not granted.
# Default: external_llm
CONSENT_REQUIRED_PURPOSES=external_llm

# Which registered egress points refuse to transmit without consent.
# See apps/accounts/egress.py for the full matrix and docs/ARCHITECTURE.md.
#
#   rag  — Only the points reached by ASKING a question
#          (generation, query embedding, rerank, classify). Uploads are NOT
#          gated: document text, images and embeddings still go to Google
#          without consent.
#   all  — DEFAULT. Adds record indexing, document parsing, OCR,
#          prediction interpretation and the seizure proxy.
#
# Behavioural change when moving to `all`: a user without valid, current
# external_llm consent can no longer trigger ANY external processing of their
# health data. Uploads still save and still parse locally (regex/tables), but
# are not indexed, OCR'd or LLM-structured until they consent. Nothing is
# deleted and nothing already processed is affected.
#
# Rollback is instant and stateless: set back to `rag` and redeploy.
CONSENT_ENFORCED_EGRESS=all
# Vendors that may receive health data: one primary and one fallback, each
# covered by a data-processing agreement.
PHI_LLM_PROVIDERS=gemini,anthropic

# ── Labs (research demos) ──────────────────────────────────────────────────────
# Seizure analysis, the real-time EEG demo, the ICU demo and model submission.
# Off by default: every Labs route returns 404. When True they require login,
# are rate-limited per user and reject uploads over MAX_UPLOAD_BYTES. The seizure
# proxy sends EEG files to a third party (hasanai.net), so leave this off in
# production unless that processor is covered by your privacy policy.
LABS_ENABLED=False

# ── Account security ───────────────────────────────────────────────────────────
# Idle sign-out for the web session, in minutes (default 30).
SESSION_IDLE_MINUTES=30
# Email verification. Defaults to "mandatory" when EMAIL_HOST_USER and
# EMAIL_HOST_PASSWORD are set, else "none" (system check accounts.W002 warns).
# Unverified users can sign in but cannot share or use the assistant.
# ACCOUNT_EMAIL_VERIFICATION=mandatory
# Two-factor authentication is required for staff, doctors, Staff (data
# scientists) and hospital admins. Leave on in production.
MFA_ENFORCED=True

# ── Platform (audit prompt 3) ──────────────────────────────────────────────────
# Shared cache for rate limits and lockouts. Production refuses to start with the
# per-process memory cache (accounts.E002) unless ALLOW_LOCAL_CACHE=True.
CACHE_URL=
# ALLOW_LOCAL_CACHE=False
# Reverse proxies in front of the app; X-Forwarded-For is read from the right,
# trusting this many hops. 1 for Render/Railway; 0 when nothing sits in front.
TRUSTED_PROXY_COUNT=1
# Redirect plain-HTTP requests to HTTPS (production default True; /health/ exempt).
# SECURE_SSL_REDIRECT=True
# Set to true where the platform runs scripts/release.sh (backup + migrate)
# before the web process; startup.sh then skips it.
RELEASE_PHASE_HANDLED=false
# Comma-separated system check ids to silence deliberately, e.g. in CI.
# SILENCED_SYSTEM_CHECKS=

# ── Field encryption (docs/FIELD_ENCRYPTION.md) ────────────────────────────────
# Comma-separated Fernet keys, newest first. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=
# Population statistics: minimum distinct patients behind any figure.
POPULATION_MIN_COHORT=5

# ── Privacy page owner details (healthcompass/legal.py) ───────────────────────
# Shown on /privacy/. `check --deploy` fails (pages.E001) while any is empty.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_BASIS=
CONTACT_EMAIL=
LEGAL_HOSTING_PROVIDER=
LEGAL_DATABASE_PROVIDER=
LEGAL_EMAIL_PROVIDER=
