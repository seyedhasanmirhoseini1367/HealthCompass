# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environment
.venv/
venv/
env/

# Django
*.sqlite3
# `*.sqlite3` does not match db.sqlite3.backup-20260815-134245 — the extension
# is no longer last. A database backup holds every patient record in it, so the
# pattern has to cover whatever gets appended.
*.sqlite3.backup-*
*.sqlite3.bak
media/
staticfiles/
static_collected/

# Environment variables — NEVER commit these
.env
*.env
.env.*
!.env.example

# Vector store cache
rag_vector_store/

# PyTorch model weights — committed (small, <2 MB each)
# ai_insights/models/*.pth

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# ML model files (large binaries)
*.pkl
*.h5
*.pt
*.pth
*.onnx
# Exception: the EEG seizure models are small enough to ship in the repo.
# ONNX only — the .pth weights they were exported from are no longer tracked;
# nothing in the serving path loads them (seizure_inference.py is ONNX-only).
!apps/ai_insights/model_weights/*.onnx

# Analysis docs generated locally
HEALTHCOMPASS_*.md
HEALTHCOMPASS_*.txt
RAG_SYSTEM_DOCUMENTATION.*

# Sensitive credential files — ignore only the specific file, not the whole directory
docs/TEST_ACCOUNTS.txt

# Generated evaluation output — never committed.
#
# These are build artefacts (corpus runs, A/B results, charts), and some are
# DERIVED FROM CREDENTIALED DATA: evaluation/mimic_subset_manifest.json carries
# real MIMIC-III subject_id values and the local dataset path. PhysioNet's
# licence prohibits redistributing dataset-derived content, and this repository
# has a public remote.
#
# Leading slash is load-bearing: a bare "evaluation/" would also match
# scripts/evaluation/, which holds the evaluation CODE and must stay tracked.
/evaluation/
